# Copy to .env (never commit .env). EVERY value below is a DEV-ONLY default: change all secrets outside a laptop.
# Real environments take secrets from OpenBao, never from a file in Git.
NODE_ENV=development
BFF_PORT=3000
AUTH_PORT=3001
CAFE_MANAGEMENT_PORT=3002
SESSION_PORT=3003
BILLING_PORT=3004
INTEGRATION_PORT=3005

# ---- Local stack ports (infra/docker-compose.yml)
# Host port (5433: a locally installed PostgreSQL usually holds 5432). Containers use postgres:5432.
POSTGRES_PORT=5433
KEYCLOAK_PORT=8081
KONG_PORT=8000
KONG_STATUS_PORT=8100

# ---- PostgreSQL (dev)
# Migrator/superuser: used only by the `migrate` and `db-roles` compose services, never by an app.
POSTGRES_PASSWORD=postgres
# One login per service (db/roles/02-logins.sql). DEV ONLY.
APP_BFF_DB_PASSWORD=app_bff_dev
APP_AUTH_DB_PASSWORD=app_auth_dev
APP_CAFE_DB_PASSWORD=app_cafe_dev
APP_SESSION_DB_PASSWORD=app_session_dev
APP_BILLING_DB_PASSWORD=app_billing_dev
APP_INTEGRATION_DB_PASSWORD=app_integration_dev
APP_READONLY_DB_PASSWORD=app_readonly_dev

# ---- Keycloak (dev): realm "instagpu" imported from infra/keycloak/realm-instagpu.dev.json
KC_PUBLIC_URL=http://localhost:8081
KC_ADMIN_PASSWORD=admin
OIDC_ISSUER=http://localhost:8081/realms/instagpu
# Audiences: user tokens (via the BFF) and service-to-service tokens
OIDC_AUDIENCE=instagpu-api
INTERNAL_AUDIENCE=instagpu-internal

# ---- Keycloak client secrets (DEV ONLY; must match the dev realm file)
BFF_OIDC_CLIENT_SECRET=dev-bff-secret-change-me
# The frontend (Vite, :8080) proxies /bff to the BFF (:3000); Keycloak redirects the browser back through it.
FRONTEND_URL=http://localhost:8080
BFF_OIDC_REDIRECT_URI=http://localhost:8080/bff/auth/callback
KEYCLOAK_PROVISIONER_CLIENT_SECRET=dev-provisioner-secret-change-me
SVC_AUTH_CLIENT_SECRET=dev-svc-auth-service-secret-change-me
SVC_CAFE_CLIENT_SECRET=dev-svc-cafe-management-service-secret-change-me
SVC_SESSION_CLIENT_SECRET=dev-svc-session-service-secret-change-me
SVC_BILLING_CLIENT_SECRET=dev-svc-billing-service-secret-change-me
SVC_INTEGRATION_CLIENT_SECRET=dev-svc-integration-service-secret-change-me

# ---- BFF session encryption (DEV ONLY): base64 of 32 bytes. Later replaced by OpenBao Transit.
SESSION_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=
