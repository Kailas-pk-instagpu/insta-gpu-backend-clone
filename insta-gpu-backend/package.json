{
  "name": "insta-gpu-backend",
  "private": true,
  "version": "0.1.0",
  "description": "InstaGPU backend: NestJS microservices in one pnpm workspace",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:libs": "pnpm --filter \"./libs/**\" build",
    "dev": "pnpm build:libs && pnpm --parallel --filter \"./services/*\" start:dev",
    "start": "pnpm --parallel --filter \"./services/*\" start",
    "test": "pnpm -r --if-present test",
    "test:db": "node --env-file-if-exists=.env scripts/test-db.mjs",
    "check:health": "node scripts/check-health.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^22.18.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "webpack": "5"
      }
    }
  }
}
