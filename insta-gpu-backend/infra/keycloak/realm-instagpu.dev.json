{
  "realm": "instagpu",
  "loginTheme": "instagpu-dev",
  "groups": [
    {
      "name": "super_admin",
      "realmRoles": [
        "super_admin"
      ]
    },
    {
      "name": "admin",
      "realmRoles": [
        "admin"
      ]
    },
    {
      "name": "cafe_owner",
      "realmRoles": [
        "cafe_owner"
      ]
    },
    {
      "name": "manager",
      "realmRoles": [
        "manager"
      ]
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@instagpu.local",
    "fromDisplayName": "InstaGPU",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "displayName": "InstaGPU",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "internationalizationEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Super Admin: InstaGPU platform, every cafe; approves branches; inherits admin, cafe_owner and manager"
      },
      {
        "name": "admin",
        "description": "Sales Manager: onboards cafes, creates cafe owners and their branches (branches need super admin approval)"
      },
      {
        "name": "cafe_owner",
        "description": "Cafe Owner: all branches of own cafe, creates managers, pays statements; inherits manager"
      },
      {
        "name": "manager",
        "description": "Floor Manager: runs the branches assigned to them (seats, sessions)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "instagpu-bff",
      "name": "InstaGPU BFF (bff-service)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bff-secret-change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8080/bff/auth/callback",
        "http://localhost:3000/bff/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:3000/*",
        "use.refresh.tokens": "true",
        "client.use.lightweight.access.token.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-instagpu-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "instagpu-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "svc-auth-service",
      "name": "auth-service (service-to-service)",
      "enabled": true,
