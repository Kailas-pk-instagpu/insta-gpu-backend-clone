{
  "name": "@instagpu/bff-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend: Keycloak login, cookie sessions, /bff/api proxy to Kong",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@instagpu/shared-config": "workspace:*",
    "@instagpu/shared-db": "workspace:*",
    "@instagpu/shared-http": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
