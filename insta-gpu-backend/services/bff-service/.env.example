# bff-service
PORT=3000
NODE_ENV=development
# Own database login (db/roles), DEV ONLY. Compose Postgres is on host port 5433.
DATABASE_URL=postgres://app_bff_login:app_bff_dev@localhost:5433/instagpu
# Keycloak client instagpu-bff (DEV ONLY secret, matches infra/keycloak/realm-instagpu.dev.json)
OIDC_ISSUER=http://localhost:8081/realms/instagpu
OIDC_CLIENT_ID=instagpu-bff
OIDC_CLIENT_SECRET=dev-bff-secret-change-me
# The frontend (Vite :8080) proxies /bff to this service, so the browser sees one origin.
FRONTEND_URL=http://localhost:8080
OIDC_REDIRECT_URI=http://localhost:8080/bff/auth/callback
KONG_URL=http://localhost:8000
# base64 of 32 bytes, DEV ONLY
SESSION_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=
