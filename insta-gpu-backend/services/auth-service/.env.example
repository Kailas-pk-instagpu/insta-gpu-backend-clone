# auth-service
PORT=3001
NODE_ENV=development
# Own database login (db/roles), DEV ONLY. Compose Postgres is on host port 5433.
DATABASE_URL=postgres://app_auth_login:app_auth_dev@localhost:5433/instagpu
# Token checks (ADR-005). Running outside Docker, Keycloak is reachable at its public address.
OIDC_ISSUER=http://localhost:8081/realms/instagpu
OIDC_AUDIENCE=instagpu-api
